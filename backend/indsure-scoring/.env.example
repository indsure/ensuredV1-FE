# IndSure Scoring Engine Environment Variables

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required: Database URL (points to indsure-data SQLite)
DATABASE_URL=file:../indsure-data/prisma/indsure.db

# Optional: OCR provider (tesseract, google-vision, aws-textract)
EXTRACTION_OCR_PROVIDER=tesseract

# Optional: Server port
INDSURE_PORT=5001

# Optional: CORS origin
CORS_ORIGIN=http://localhost:3000

# Optional: Environment
NODE_ENV=development
