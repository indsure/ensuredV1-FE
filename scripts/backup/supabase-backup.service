[Unit]
Description=IndSure nightly backup to Cloudflare R2 (database + documents)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/indsure/backup/nightly-backup.sh
Environment=BACKUP_ENV_FILE=/etc/indsure/backup.env
# ProtectHome hides /root, so give gpg and the AWS CLI a writable home that
# lives inside the one path this unit is allowed to write to.
Environment=HOME=/var/backups/supabase
Environment=GNUPGHOME=/var/backups/supabase/.gnupg
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle

# The unit reads the DB password and encryption passphrase, so keep it boxed in.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/supabase

# ProtectHome is read-only, not true, because the storage half reads the app's
# Supabase service key from its .env under /home. With ProtectHome=true systemd
# puts an empty tmpfs over /home and the run died with "cannot read ... for the
# Supabase keys", even though both scripts work by hand as root.
#
# BindReadOnlyPaths= was tried first, to grant exactly that one file. It does not
# work here: the bind cannot be established through the tmpfs ProtectHome=true
# lays down. read-only is the honest trade. /home becomes readable to a unit that
# already runs as root and already reads one secret from it, and writes to /home
# are still blocked. Everything this unit creates goes to /var/backups/supabase.
ProtectHome=read-only
