[Unit]
Description=Run the IndSure Supabase backup nightly

[Timer]
# 02:30 IST (21:00 UTC the previous day), jittered to avoid a thundering herd.
OnCalendar=*-*-* 21:00:00 UTC
RandomizedDelaySec=900
# If the box was off at the scheduled time, run as soon as it is back.
Persistent=true
Unit=supabase-backup.service

[Install]
WantedBy=timers.target
