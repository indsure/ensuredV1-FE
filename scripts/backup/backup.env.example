# Copy to /etc/indsure/backup.env on the EC2 box, then: chmod 600, chown root:root
# This file holds a database password. It must never be committed.

# Supabase SESSION pooler — port 5432, NOT the app's 6543 transaction pooler.
# Get it from: Supabase Dashboard -> Connect -> Session pooler.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Cloudflare R2. Endpoint is https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=indsure-backups
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PREFIX=supabase
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
AWS_DEFAULT_REGION=auto

# Symmetric key used to encrypt every dump before upload.
# LOSING THIS FILE MEANS LOSING EVERY BACKUP. Store a copy in a password manager.
GPG_PASSPHRASE_FILE=/etc/indsure/backup.passphrase

# Retention
LOCAL_KEEP=3
REMOTE_KEEP_DAYS=30

# Optional but strongly recommended: a free healthchecks.io ping URL.
# Without it, a backup that silently stops running looks exactly like one that works.
HEALTHCHECK_URL=
