# Deliberately narrow. The rest of the repo is CRLF in the working tree and a
# blanket rule here would renormalise hundreds of files in one unreviewable diff.

# Git hooks must stay LF even on Windows (core.autocrlf=true). With CRLF the
# shebang becomes "#!/usr/bin/env bash\r" and every hook run dies with
# "bad interpreter: /usr/bin/env bash^M" -- silently disabling the check.
.githooks/** text eol=lf

# Same reasoning for the backup scripts and systemd units: they are copied to
# the EC2 box and executed there, so CRLF would break the shebang and the
# unit-file parser.
scripts/backup/*.sh text eol=lf
scripts/backup/*.service text eol=lf
scripts/backup/*.timer text eol=lf
