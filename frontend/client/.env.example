# Frontend build-time config.
#
# IMPORTANT: env files must live HERE (frontend/client/), not next to
# frontend/package.json. Vite's `root` is set to client/ in vite.config.ts, and
# envDir defaults to root — a .env in frontend/ is silently ignored.
#
# On Vercel this does not apply: dashboard env vars arrive as process.env and
# Vite picks up anything prefixed VITE_ regardless of envDir.
#
# Copy to .env.local for local development. Never commit .env.local.

# --- Mixpanel (analytics + Session Replay) ---------------------------------
# Project token. Without it Mixpanel is completely inert — no init, no replay,
# no events. This is the only variable required to switch analytics on.
VITE_MIXPANEL_TOKEN=

# Data residency. Project "Indsure" (4039086) is a US-residency project, so the
# default is the US host and you should not need this. India would be
# https://api-in.mixpanel.com, EU https://api-eu.mixpanel.com.
#
# WARNING: a wrong host here fails SILENTLY. The other region's edge still
# returns HTTP 200 {"error":null,"status":1}, but the events land in a cluster
# where the project does not exist. Verify delivery in the Events view, never by
# the HTTP status.
# VITE_MIXPANEL_API_HOST=https://api.mixpanel.com

# Replay sampling rate, where 1 = 1%. Defaults to 100 so the implementation can
# be verified end to end; lower it once you know your volume.
# VITE_MIXPANEL_RECORD_PERCENT=100

# Mixpanel resolves country/region/city from the request IP by default, which
# is what powers geo breakdowns. Set to "true" to switch that off — you lose
# only the geo columns.
# VITE_MIXPANEL_DISABLE_IP=true

# Analytics normally ship from production builds only. Set this to "true" to
# exercise Mixpanel from `npm run dev` against a SANDBOX project — never point
# a debug session at the production token. Also exposes window.mixpanel.
# VITE_MIXPANEL_DEBUG=true

# --- Other -----------------------------------------------------------------
# VITE_API_URL=
