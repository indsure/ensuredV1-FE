# Copy to .env on the server. Never commit .env or the auth folder: the repo is public.
WA_BOT_ENABLED=true
# Same value as WA_BOT_KEY in the backend's env. 32+ random chars: openssl rand -hex 32
WA_BOT_KEY=
BACKEND_URL=http://127.0.0.1:5000
# Baileys session (the bot's WhatsApp login). Outside the repo, owner-only, backed up.
WA_AUTH_DIR=/home/ubuntu/wa-auth
WA_TMP_DIR=/tmp/indsure-wa
WA_PUBLIC_ORIGIN=https://indsure.in
# Where "message the IndSure team" points (T9).
WA_TEAM_LINK=https://indsure.in/advisors-pricing
# Optional: pair with an 8-character code instead of a QR (the bot SIM's number, digits).
WA_PAIR_PHONE=
