{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "npm run dev --prefix frontend",
    "dev": "tsx backend/server/index.ts",
    "launch": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run dev:client\"",
    "dev:all": "concurrently \"tsx backend/server/index.ts\" \"tsx backend/src/index.ts\" \"npm run dev --prefix frontend\" \"npm run dev --prefix admin-app -- -p 3002\"",
    "build": "npm run build --prefix frontend && tsc --noEmit --project backend/tsconfig.json",
    "start": "tsx backend/server/index.ts",
    "check": "tsc --noEmit --project backend/tsconfig.json",
    "health-check": "tsx backend/server/tests/engineHealthCheck.ts",
    "guard": "node checks/guard.mjs",
    "check:teams": "node checks/teams-sql-smoke.mjs",
    "check:pending-email": "node checks/pending-upload-email-smoke.mjs",
    "test": "tsx --test backend/server/tests/*.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.99.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.4",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.20.0",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.27",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.18.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
