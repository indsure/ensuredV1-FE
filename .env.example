# Copy to .env at the repo root and fill in real values. Never commit .env.
#
# The ad-hoc DB scripts (run_migration.mjs, check_db.mjs, backend/query_db.mjs,
# backend/server/*_db.ts, ...) all read DATABASE_URL and exit if it is unset.
# Either export it in your shell or load this file before running them.
#
# Note: Vite only picks up frontend env files from frontend/client/, not
# frontend/ -- put the VITE_* vars there, not here.

# --- Database ---------------------------------------------------------------
# Supabase pooler connection string. Include the password inline here only;
# this file is the example, so keep it as a placeholder.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=no-verify

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Bypasses RLS. Server-side only -- never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Frontend (belongs in frontend/client/.env) -----------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_API_URL=https://<backend-host>

# --- AI ---------------------------------------------------------------------
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash
GEMINI_PRICE_INPUT_PER_M=0
GEMINI_PRICE_OUTPUT_PER_M=0

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173
SERVE_STATIC=false

# --- Mail (Amazon SES, ap-south-1) ------------------------------------------
MAIL_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=<ses-smtp-user>
MAIL_SMTP_PASS=<ses-smtp-password>
MAIL_FROM=no-reply@indsure.in
GRIEVANCE_SMTP_USER=<ses-smtp-user>
GRIEVANCE_SMTP_PORT=587

# --- Privacy / retention ----------------------------------------------------
# Random per-environment salts; changing them invalidates existing hashes.
IP_HASH_SALT=<random-string>
USAGE_HASH_SALT=<random-string>
RETENTION_GRACE_DAYS=30
